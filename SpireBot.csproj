<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\local.props" Condition="Exists('.\local.props')"/>
    <Import Project=".\Sts2PathDiscovery.props"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>

        <!-- Needed so `dotnet build` resolves + copies the ONNX Runtime's win-x64 native asset
             (onnxruntime.dll) to the output directory; without a RID, NuGet has no platform to
             pick a runtimes/<rid>/native asset for, and the mod would crash at load. This is a
             library, not a publishable app, so SelfContained stays false. -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>false</SelfContained>

        <!-- MUST stay explicit. Setting a RuntimeIdentifier makes the SDK *infer*
             PlatformTarget from the RID's architecture (win-x64 -> x64), which stamps the
             managed assembly's PE header as AMD64/PE32+ instead of AnyCPU. The game's mod
             loader calls AssemblyLoadContext.LoadFromAssemblyPath, and on an arm64 runtime
             (Apple Silicon) an AMD64-stamped assembly throws
                 System.IO.FileLoadException: ... The assembly architecture is not compatible
                 with the current process architecture
             before a single line of our code runs. BaseLib and Microsoft.ML.OnnxRuntime are
             both AnyCPU; we were the only assembly in the mod folder that wasn't. Forcing
             AnyCPU here keeps the RID doing its only real job (resolving the native
             runtimes/<rid>/native asset above) without making our IL architecture-specific.
             Verify after touching this: the PE header of the built SpireBot.dll must read
             Machine=0x014C / Magic=0x010B, not 0x8664 / 0x020B. -->
        <PlatformTarget>AnyCPU</PlatformTarget>

        <!-- Single source of the ONNX Runtime version: the PackageReferences below AND the
             cross-platform native copy (OnnxMacNativeFiles) read it, so they cannot drift apart
             and silently ship a mismatched dylib next to a newer managed wrapper. -->
        <OnnxRuntimeVersion>1.20.1</OnnxRuntimeVersion>

        <!-- Class-library projects default this to false (only the final app is expected to copy its
             dependencies locally); Godot itself relies on that default, resolving its own managed
             dependencies from the NuGet cache via deps.json at launch. Our mod loader has no such
             resolution and loads SpireBot.dll standalone, so anything it needs (namely the ONNX Runtime's
             managed wrapper) must physically ship next to it. This also pulls in GodotSharp.dll /
             GodotSharpEditor.dll, which we deliberately do NOT forward to the mods folder below — the
             game already has those loaded in-process, and shipping a second copy risks a type-identity
             mismatch. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Disable architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <PropertyGroup>
        <!-- BaseLib may be installed via Steam Workshop rather than the mods folder;
             override BaseLibDllPath in local.props to point at the Workshop copy. -->
        <BaseLibDllPath Condition="'$(BaseLibDllPath)' == ''">$(ModsPath)BaseLib/BaseLib.dll</BaseLibDllPath>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(ModsPath)')">
        <Reference Include="BaseLib">
            <HintPath>$(BaseLibDllPath)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <!-- Publicizes originally private/protected sts2 members for our HarmonyLib patches / obs builder. -->
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <!-- Not provided by the game or by another mod, so these stay copy-local (the PackageReference
             default) unlike the References above, which are all Private=false. Microsoft.ML.OnnxRuntime
             is native-binaries-only (its native onnxruntime.dll needs RuntimeIdentifier=win-x64 above to
             get resolved/copied); the actual C# API lives in Microsoft.ML.OnnxRuntime.Managed, which we
             must reference directly too, or Godot.NET.Sdk won't copy it to the output dir (Godot's own
             launch path resolves dependencies from the NuGet cache via deps.json instead of copying them
             locally; our mod loader has no such resolution and loads SpireBot.dll standalone, so every
             dependency it needs must physically sit next to it in mods\SpireBot\). -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="$(OnnxRuntimeVersion)" />
    </ItemGroup>

    <!-- macOS ONNX Runtime binaries, taken straight from the restored NuGet package. NuGet resolves
         native assets for the single RuntimeIdentifier above (win-x64) only, so the Mac ones have to
         be copied by hand or a Mac subscriber gets a mod that loads and then cannot build an
         InferenceSession.

         These do NOT go flat next to the DLL the way the Windows pair does: osx-arm64 and osx-x64
         both name their library libonnxruntime.dylib, so they would overwrite each other. Keeping the
         runtimes/<rid>/native/ layout lets both ship; AssemblyResolution picks the one matching the
         running process and loads it by absolute path. -->
    <PropertyGroup>
        <OnnxRuntimePackageDir>$(NuGetPackageRoot)microsoft.ml.onnxruntime/$(OnnxRuntimeVersion)/</OnnxRuntimePackageDir>
    </PropertyGroup>

    <ItemGroup>
        <OnnxMacNativeFiles Include="$(OnnxRuntimePackageDir)runtimes/osx-arm64/native/*">
            <Rid>osx-arm64</Rid>
        </OnnxMacNativeFiles>
        <OnnxMacNativeFiles Include="$(OnnxRuntimePackageDir)runtimes/osx-x64/native/*">
            <Rid>osx-x64</Rid>
        </OnnxMacNativeFiles>
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="SpireBot.json" />
        <None Include="local.props.template" />
        <None Include="Sts2PathDiscovery.props" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    </Target>

    <PropertyGroup>
        <!-- Everyday dev deploy into the game's mods folder. Defaults ON (the long-standing
             behaviour); build with -p:DeployToModsFolder=false to skip it, which is what you want
             while verifying a Workshop or mods_STEAMTEST copy - a redeployed dev mod would
             otherwise win the loader's same-id dedup and shadow the copy under test. -->
        <DeployToModsFolder Condition="'$(DeployToModsFolder)' == ''">true</DeployToModsFolder>
    </PropertyGroup>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployToModsFolder)' == 'true'">
        <ItemGroup>
            <!-- Everything else dotnet build put in the output dir: the ONNX Runtime managed wrapper,
                 its native onnxruntime.dll/onnxruntime_providers_shared.dll, and any other copy-local
                 dependency — EXCEPT GodotSharp*.dll, which the game already provides in-process. -->
            <SpireBotOtherOutputFiles Include="$(TargetDir)*.dll" Exclude="$(TargetPath);$(TargetDir)GodotSharp*.dll" />
            <!-- The repo is the single source of the policy artifacts: dev deploys get the same
                 dist/model/ files the Workshop item ships, so a dev install resolves the model
                 next to the DLL with no configured path, exactly like a subscriber's does. Before
                 this, model\ was placed here out-of-band and a fresh deploy had no model at all. -->
            <SpireBotModelFiles Include="$(MSBuildProjectDirectory)/dist/model/*" />
        </ItemGroup>
        <Message Text="Copying .dll .pdb .json, native runtime files and dist/model to mods folder." Importance="high" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
        <Copy SourceFiles="@(SpireBotOtherOutputFiles)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" Condition="'@(SpireBotOtherOutputFiles)' != ''" />
        <Copy SourceFiles="@(SpireBotModelFiles)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/model/" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(OnnxMacNativeFiles)"
              DestinationFolder="$(ModsPath)$(MSBuildProjectName)/runtimes/%(OnnxMacNativeFiles.Rid)/native/"
              SkipUnchangedFiles="true"
              Condition="'@(OnnxMacNativeFiles)' != ''" />
    </Target>

    <!-- Stages the Steam Workshop item content (BaseLib's mod_upload convention). Off by default;
         run `dotnet build -p:UploadBuild=true` (or scripts/stage-workshop.ps1). The staged folder is
         wiped first so removed files (e.g. old model versions) can't linger in the published item.
         Ships the same DLL set as the mods folder (minus the .pdb) plus the repo-canonical model
         artifacts from dist/ - NOT the live mods\SpireBot\model folder, which carries .bak files. -->
    <Target Name="CopyToUploadFolderOnBuild" AfterTargets="CopyToModsFolderOnBuild" Condition="'$(UploadBuild)' == 'true'">
        <PropertyGroup>
            <WorkshopContentDir>$(Sts2Path)/mod_upload/$(MSBuildProjectName)/content/$(MSBuildProjectName)/</WorkshopContentDir>
        </PropertyGroup>
        <ItemGroup>
            <WorkshopOtherDlls Include="$(TargetDir)*.dll" Exclude="$(TargetPath);$(TargetDir)GodotSharp*.dll" />
            <WorkshopModelFiles Include="$(MSBuildProjectDirectory)/dist/model/*" />
            <WorkshopLicenseFiles Include="$(MSBuildProjectDirectory)/dist/licenses/*" />
        </ItemGroup>
        <!-- A Workshop build is the one that reaches other people's machines, so a missing Mac
             binary is an error here rather than a warning. Shipping without it produced a
             subscriber-visible failure once already (an x64-stamped SpireBot.dll that no Apple
             Silicon process could even load); a silently Windows-only item is the same class of
             mistake, just quieter. Everyday `dotnet build` stays unaffected. -->
        <Error Condition="'@(OnnxMacNativeFiles)' == ''"
               Text="No macOS ONNX Runtime binaries found under $(OnnxRuntimePackageDir)runtimes/osx-*/native/. A Workshop build must not ship Windows-only; run `dotnet restore` and retry." />
        <RemoveDir Directories="$(WorkshopContentDir)" />
        <Message Text="Staging Workshop item content to $(WorkshopContentDir)" Importance="high" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(WorkshopContentDir)" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(WorkshopContentDir)" />
        <Copy SourceFiles="@(WorkshopOtherDlls)" DestinationFolder="$(WorkshopContentDir)" Condition="'@(WorkshopOtherDlls)' != ''" />
        <Copy SourceFiles="@(WorkshopModelFiles)" DestinationFolder="$(WorkshopContentDir)model/" />
        <Copy SourceFiles="@(OnnxMacNativeFiles)"
              DestinationFolder="$(WorkshopContentDir)runtimes/%(OnnxMacNativeFiles.Rid)/native/" />
        <Copy SourceFiles="@(WorkshopLicenseFiles)" DestinationFolder="$(WorkshopContentDir)licenses/" />
        <Copy SourceFiles="SpireBotCode/Replay/LICENSE" DestinationFiles="$(WorkshopContentDir)licenses/LICENSE-RunReplays.txt" />
    </Target>
</Project>
